# Discord 봇 토큰 (필수)
DISCORD_TOKEN=TOKEN

# 명령어 접두사 (선택, 기본값: !)
COMMAND_PREFIX=!

# PostgreSQL 데이터베이스 URL (필수)
# 형식: postgresql://username:password@host:port/database
# 기본값: postgresql://root:root@localhost:5432/studydb
DATABASE_URL=postgresql://root:root@localhost:5432/studydb

# PostgreSQL 설정 (Docker Compose 사용 시)
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_DB=studydb
POSTGRES_PORT=5432

# 크롤링 간격 (초 단위, 기본값: 3600 = 1시간)
CRAWL_INTERVAL=3600

# 로그 레벨 (선택, 기본값: INFO)
# 가능한 값: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# 로그 파일명 (선택, 기본값: hotdeal_bot.log)
LOG_FILE=hotdeal_bot.log

# Google Gemini API Key (선택)
# 설정 시 핫딜 1차 알림 3시간 후 AI 추천/비추천 2차 알림 기능이 활성화됩니다.
# 미설정 시 기존 봇 동작에 영향 없음
# 발급: https://aistudio.google.com/app/apikey
# 무료 티어: Key 1개당 20 req/day (PST 자정 기준 리셋)
# KEY_1,2,3 라운드로빈으로 최대 60 req/day 확보 가능
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# 단일 키만 사용할 경우 (KEY_1,2,3 미설정 시 폴백)
# GEMINI_API_KEY=

# AI 분석 지연 시간 (시간 단위, 기본값: 3)
AI_ANALYSIS_DELAY_HOURS=3

# 애플 리퍼비쉬 MacBook Pro 감시 (운영자용)
# 디스코드에서 `!키워드 추가 애플리퍼` 로 등록한 사용자에게만 알림. 등록자 없으면 크롤링 안 함.
# 구매 후 `!키워드 삭제 애플리퍼` 로 끄면 됨.
APPLE_REFURB_TRIGGER_KEYWORD=애플리퍼
# 감시 주기(분), 기본 10
APPLE_REFURB_INTERVAL_MINUTES=10
# 조건 (기본값 = MacBook Pro 14인치 / 메모리 64GB 이상 / 저장 1TB 이상 / M3,M4,M5)
APPLE_REFURB_MODEL=macbookpro
APPLE_REFURB_SCREEN=14inch
APPLE_REFURB_MIN_MEMORY_GB=64
APPLE_REFURB_MIN_STORAGE_GB=1024
APPLE_REFURB_CHIPS=M3,M4,M5
# 가격 상한(원). 비우면 제한 없음
APPLE_REFURB_MAX_PRICE=
